# =============================================================================
# CNTCollect - Accounts Receivable & Payment Recovery Operating Platform
# PART 33: PRODUCTION ENVIRONMENT VARIABLE CONFIGURATION TEMPLATE
# =============================================================================
# CLASSIFICATION LEGEND:
# [R-START]  : Required for the current application to start.
# [R-FEAT]   : Required only for a specific enabled feature.
# [OPT-DEF]  : Optional with a safe default.
# [NOT-USED] : Not currently used and removable from deployment requirements.
# [FUTURE]   : Required only after a future external integration is activated.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. RUNTIME & SERVER NETWORKING
# -----------------------------------------------------------------------------
# [OPT-DEF] Node.js runtime environment mode.
# Safe Default: 'development' locally, 'production' in Docker container.
# Side: Server-side environment variable.
NODE_ENV="production"

# [OPT-DEF] HTTP port on which Express dev/prod server listens.
# Safe Default: 3000 (Cloud Run injects PORT=3000 or PORT=8080 automatically).
# Side: Server-side environment variable.
PORT=3000

# [OPT-DEF] Comma-separated list of allowed CORS and iframe origins.
# Safe Default: Pre-configured with AI Studio development and shared URLs.
# Side: Server-side configuration.
ALLOWED_ORIGINS="https://ais-dev-p5qs4ppwu4nlitu3j2rcpd-233428534328.europe-west2.run.app,https://ais-pre-p5qs4ppwu4nlitu3j2rcpd-233428534328.europe-west2.run.app,http://localhost:3000"

# [OPT-DEF] Secret key for signing time-limited private document download links.
# Safe Default: 'cntcollect_secure_vault_signing_key_9941a8e2'
# Side: Server-side secret (Override in Secret Manager for production).
SIGNED_URL_SECRET="CHANGE_ME_IN_PRODUCTION_SECRET_MANAGER_64_HEX"


